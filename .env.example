# ATSInfra Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://atsinfra:atsinfra@localhost:5432/atsinfra
POSTGRES_USER=atsinfra
POSTGRES_PASSWORD=atsinfra
POSTGRES_DB=atsinfra

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# S3 Storage (MinIO for local development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=atsinfra-uploads
S3_REGION=us-east-1

# Service URLs
PARSER_SERVICE_URL=http://localhost:8001
PDF_SERVICE_URL=http://localhost:8002
SEMANTIC_SERVICE_URL=http://localhost:8003

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# API Keys (for external services)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx

# Model Configuration
MODEL_CACHE_DIR=/models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLP_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_SEMANTIC_MATCHING=true
ENABLE_PDF_REPAIR=true
ENABLE_ANALYTICS=true
